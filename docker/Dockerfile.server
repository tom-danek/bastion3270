# syntax=docker/dockerfile:1
#
# bastion3270-server — container image.
#
#   docker build -f docker/Dockerfile.server -t bastion3270-server:dev .
#
# Stage 1 builds a fully static musl binary; stage 2 is `scratch` (no shell, no package
# manager, no libc): the image contains the binary, its config and nothing else (~10 MB).

# ─── Stage 1: build ────────────────────────────────────────────────────────────────
# Pinned by version and digest (reproducible builds, no silently swapped base image);
# Dependabot proposes updates (.github/dependabot.yml).
FROM docker.io/library/rust:1.99.1-alpine@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 AS build
RUN apk add --no-cache musl-dev
WORKDIR /src

# Manifests first, sources second: unchanged dependencies stay in the layer cache.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p bastion3270-server \
 && install -D -m 0755 target/release/bastion3270-server /out/bastion3270-server

# ─── The binary alone (release archives) ───────────────────────────────────────────
#   docker build -f docker/Dockerfile.server --target binary --output type=local,dest=out .
FROM scratch AS binary
COPY --from=build /out/bastion3270-server /bastion3270-server

# ─── Stage 2: runtime ──────────────────────────────────────────────────────────────
FROM scratch
LABEL org.opencontainers.image.title="bastion3270-server" \
      org.opencontainers.image.description="TN3270 web gateway: runs 3270 sessions on the server and serves a browser client" \
      org.opencontainers.image.source="https://github.com/tom-danek/bastion3270" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/bastion3270-server /bastion3270-server
# No configuration in the image: it is mounted at /etc/bastion3270/ (compose volume, Kubernetes
# ConfigMap). Without one the gateway refuses to start instead of serving the lab example.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES /usr/share/doc/bastion3270/

# Non-root numeric UID/GID (no /etc/passwd needed); matches the K8s securityContext.
USER 65532:65532
EXPOSE 8080
ENV RUST_LOG=info \
    BASTION3270_LOG_FORMAT=json

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/bastion3270-server", "--healthcheck", "127.0.0.1:8080"]

ENTRYPOINT ["/bastion3270-server"]
CMD ["--config", "/etc/bastion3270/bastion3270-server.toml"]
